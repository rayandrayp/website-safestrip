<section id="mekanisme" class="py-24 px-6 lg:px-10 bg-slate-50">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col lg:flex-row gap-16 items-start">
      <!-- Sisi Kiri: Penjelasan + Indikator Statis -->
      <div class="flex-1 space-y-8">
        <div>
          <span
            class="text-accent-blue font-semibold tracking-wider uppercase text-sm"
            >Cara Kerja</span
          >
          <h2
            class="text-4xl lg:text-5xl font-bold text-navy leading-tight mt-2"
          >
            Sensor Pintar <br /> dalam Genggaman
          </h2>
          <p class="text-lg text-navy-muted/70 mt-6 max-w-lg">
            Safestrip memanfaatkan reaksi kimia alami yang sensitif terhadap gas
            amonia (NH3) yang dihasilkan oleh protein saat membusuk.
          </p>
        </div>

        <!-- Indikator Visual -->
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <h3
            class="text-xs font-bold text-slate-400 tracking-widest text-center uppercase mb-6"
          >
            Indikator Visual
          </h3>

          <!-- Gradient Bar — DIUBAH: fuchsia-500 (segar) → teal-500 (tidak layak) -->
          <div
            class="h-4 w-full rounded-full shadow-inner"
            style="background: linear-gradient(to right, #d946ef, #a855f7, #14b8a6);"
          >
          </div>

          <!-- Labels -->
          <div
            class="flex justify-between mt-3 text-sm font-medium text-slate-600"
          >
            <span>Ungu Kemerahan · Segar</span>
            <span>Hijau Kebiruan · Tidak Layak</span>
          </div>
        </div>
      </div>

      <!-- Sisi Kanan: Simulasi Interaktif -->
      <div class="relative w-full lg:w-96 lg:mt-10">
        <div
          class="absolute -inset-4 bg-gradient-to-tr from-blue-100 to-teal-100 rounded-[2rem] blur-2xl opacity-50"
        >
        </div>

        <div
          class="relative bg-white p-8 rounded-[2rem] shadow-2xl shadow-blue-900/10 border border-slate-100 flex flex-col items-center"
        >
          <p
            class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-8"
          >
            Uji Coba Sensor
          </p>

          <!-- Sensor Visual — DIUBAH: fuchsia-500 (ungu-pink) sebagai warna awal (segar) -->
          <div
            id="sensor-visual"
            class="w-20 h-40 rounded-full transition-all duration-700 ease-in-out border-4 border-white"
            style="background-color: #d946ef; box-shadow: 0 0 20px rgba(217, 70, 239, 0.35);"
          >
          </div>

          <div class="mt-8 text-center">
            <h3 id="status-text" class="text-2xl font-bold text-navy">Segar</h3>
            <p id="desc-text" class="text-sm text-slate-500 mt-1">
              Daging dalam kondisi optimal
            </p>
          </div>

          <button
            id="simulate-btn"
            class="mt-8 w-full py-3 rounded-xl bg-navy text-white font-semibold hover:bg-navy-muted transition-all active:scale-95"
          >
            Simulasi Pembusukan
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sensor = document.getElementById("sensor-visual") as HTMLElement;
  const statusTx = document.getElementById("status-text") as HTMLElement;
  const descTx = document.getElementById("desc-text") as HTMLElement;
  const btn = document.getElementById("simulate-btn") as HTMLButtonElement;

  // ── Definisi warna sesuai permintaan ─────────────────────────────────
  const STATE = {
    segar: {
      // Ungu-pink (Image 2) — fuchsia-500
      bg: "#d946ef",
      shadow: "0 0 20px rgba(217, 70, 239, 0.35)",
      label: "Segar",
      desc: "Daging dalam kondisi optimal",
      btn: "Simulasi Pembusukan",
    },
    busuk: {
      // Hijau-biru (Image 1) — teal-500
      bg: "#14b8a6",
      shadow: "0 0 20px rgba(20, 184, 166, 0.40)",
      label: "Tidak Layak",
      desc: "Daging sudah mulai membusuk",
      btn: "Reset ke Kondisi Segar",
    },
  };

  let isSegar = true;

  btn.addEventListener("click", () => {
    isSegar = !isSegar;
    const s = isSegar ? STATE.segar : STATE.busuk;

    sensor.style.backgroundColor = s.bg;
    sensor.style.boxShadow = s.shadow;
    statusTx.textContent = s.label;
    descTx.textContent = s.desc;
    btn.textContent = s.btn;
  });
</script>
