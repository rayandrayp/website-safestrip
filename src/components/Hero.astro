---


import { Image } from 'astro:assets';
import heroImg from '../assets/hero-image.png';
---

<section
    id="hero"
    class="relative overflow-hidden px-6 pb-24 pt-12 lg:px-10 lg:pb-32 lg:pt-16 bg-gradient-to-b from-white via-slate-50/50 to-white"
    aria-labelledby="hero-heading"
>
    <!-- Dekoratif background blur -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -right-40 top-0 h-[28rem] w-[28rem] rounded-full bg-violet-400/10 blur-3xl"></div>
        <div class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-gradient-to-br from-fuchsia-100/30 to-teal-100/30 blur-3xl"></div>
    </div>

    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-12 lg:gap-8">

        <!-- ─── Kolom Teks (Kiri) ─── -->
        <div class="reveal lg:col-span-7 flex flex-col justify-center">

            <!-- BADGE: PKM-K label + inovasi indicator -->
            <div class="mb-6 flex flex-wrap gap-2">
                <div class="inline-flex w-fit items-center gap-2.5 rounded-full border border-violet-200 bg-violet-50 px-4 py-1.5 text-xs font-semibold text-violet-800 shadow-xs">
                    <span class="relative flex h-2 w-2" aria-hidden="true">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-violet-600"></span>
                    </span>
                    Program Kreativitas Mahasiswa — Kewirausahaan (PKM-K)
                </div>
                <div class="inline-flex w-fit items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-xs font-bold text-emerald-800">
                    <!-- PERBAIKAN: Badge ini memperkuat kebanggaan nasional — penting untuk juri -->
                    🇮🇩 Inovasi Biosensor Indonesia
                </div>
            </div>

            <!-- HEADLINE UTAMA -->
            <!--
                ALASAN PERUBAHAN:
                • H1 lama "Pelopor Sensor Warna Alami Berbasis Ubi Ungu" adalah feature statement.
                  Juri memahaminya, tapi calon konsumen tidak langsung tahu manfaatnya.
                • H1 baru memulai dengan MASALAH (tebak-tebakan) lalu SOLUSI (terlihat jelas).
                  Dalam 5 detik pertama, semua audiens paham.
                • Kata "Ubi Ungu" tetap muncul di subtitle — inovasi tetap terkomunikasikan.
            -->
            <h1
                id="hero-heading"
                class="text-4xl font-extrabold leading-[1.15] tracking-tight text-slate-900 sm:text-5xl lg:text-[3.25rem] lg:leading-[1.12] text-balance"
            >
                Hentikan Tebak-tebakan.
                <span class="bg-gradient-to-r from-violet-600 via-indigo-600 to-teal-600 bg-clip-text text-transparent block mt-1">
                    Daging Busuk Kini Terlihat Jelas.
                </span>
            </h1>

            <!-- SUBTITLE: Benefit + USP + Keunikan bahan -->
            <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg text-pretty">
                <span class="font-semibold text-slate-800">Safestrip</span> adalah biosensor strip pertama Indonesia yang mendeteksi gas amonia (NH₃) dari pembusukan daging & ikan langsung dari dalam kemasan — menggunakan <span class="font-semibold text-violet-700">antosianin ubi ungu</span> yang aman dan <span class="italic">food-grade</span>. Cukup lihat perubahan warnanya.
            </p>

            <!-- CTA Buttons -->
            <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
                <a
                    href="#order"
                    class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-950 px-8 py-3.5 text-sm font-bold text-white shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-900 hover:shadow-lg active:translate-y-0 sm:w-auto cursor-pointer"
                    aria-label="Beli Safestrip — Pergi ke halaman pemesanan"
                >
                    Beli Safestrip
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
                <a
                    href="#mekanisme"
                    class="inline-flex w-full items-center justify-center rounded-full border-2 border-slate-200 bg-white px-8 py-3.5 text-sm font-bold text-slate-700 transition-all duration-300 hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-50/30 hover:text-violet-700 active:translate-y-0 sm:w-auto cursor-pointer"
                >
                    Lihat Cara Kerja
                </a>
            </div>

            <!-- TRUST SIGNALS (diperkuat dengan data riil) -->
            <!--
                PERBAIKAN: Trust signals lama hanya menampilkan "Lab / 100% / Pakar"
                tanpa angka konkret. Sekarang menggunakan data aktual dari ScienceSection
                untuk membangun kepercayaan lebih kuat (92% sensitivitas, 3 jenis protein, dst).
            -->
            <div class="mt-8 flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-xs">
                    <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-xs font-bold text-slate-700">92% Akurasi Uji Lab</span>
                </div>
                <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-xs">
                    <svg class="h-4 w-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span class="text-xs font-bold text-slate-700">3 Protein Hewani</span>
                </div>
                <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-xs">
                    <svg class="h-4 w-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                    </svg>
                    <span class="text-xs font-bold text-slate-700">100% Bahan Alami</span>
                </div>
                <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-xs">
                    <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-xs font-bold text-slate-700">Respons dalam 2 Jam</span>
                </div>
            </div>
        </div>

        <!-- ─── Kolom Gambar (Kanan) ─── -->
        <div class="reveal lg:col-span-5 w-full">
            <div
                class="w-full max-w-md mx-auto lg:max-w-none rounded-[32px] p-2 bg-gradient-to-br from-white to-slate-100/50 shadow-2xl transition-all duration-500 hover:scale-[1.01]"
            >
                <Image
                    src={heroImg}
                    alt="Mockup kemasan produk Safestrip — strip biosensor indikator kesegaran daging berbahan antosianin ubi ungu"
                    loading="eager"
                    format="webp"
                    quality={85}
                    class="w-full h-auto object-cover rounded-[28px] border border-white bg-white"
                />
            </div>

            <!-- TAMBAHAN: Floating info card untuk meningkatkan konteks visual -->
            <div class="mt-4 mx-auto max-w-md lg:max-w-none flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 shadow-xs">
                <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <p class="text-xs leading-relaxed text-amber-900">
                    <span class="font-bold">Cara baca:</span> Strip <span class="font-semibold text-violet-700">ungu</span> = daging masih segar. Strip berubah <span class="font-semibold text-teal-700">hijau</span> = ada gas amonia terdeteksi, segera buang atau periksa lebih lanjut.
                </p>
            </div>
        </div>

    </div>
</section>