---
// TestimonialSection.astro
//
// Ditempatkan di: antara <Spesifikasi /> dan <OrderSection /> di index.astro
// Logika: social proof ditempatkan tepat sebelum conversion point (OrderSection)
// mengikuti pola AIDA klasik (Interest → Desire → Action).
//
// 6 testimoni mencakup 4 segmen pasar:
//  • Konsumen Pribadi (ibu RT, mahasiswi)
//  • UMKM Kuliner (warung, katering)
//  • Reseller Online (frozen food)
//  • Layanan Publik (kantin sekolah)
//
// Layout:
//  • Desktop: 1 featured card (full-width) + grid 3 kolom untuk 5 card lainnya
//  • Tablet:  featured full-width + grid 2 kolom
//  • Mobile:  semua card stack 1 kolom

const testimonials = [
  // ── FEATURED ────────────────────────────────────────────────────────────────
  // Dipilih karena: cerita paling lengkap, segmen B2B, volume pesanan tinggi,
  // dan menyentuh aspek keselamatan konsumen — paling persuasif untuk investor
  // dan juri PKM sekaligus.
  {
    name: "Siti Rahayu",
    initials: "SR",
    role: "Pemilik Katering Harian",
    company: "Dapur Bu Siti",
    location: "Sidoarjo, Jawa Timur",
    badgeLabel: "Katering & UMKM",
    badgeClass: "bg-white/20 text-white border border-white/30",
    avatarRing: "ring-white/40",
    stars: 5,
    featured: true,
    quote:
      "Katering saya memasak 250 porsi per hari dengan bahan utama ayam dan sapi. Sebelumnya pernah ada insiden daging yang tampak segar tapi ternyata sudah mulai bermasalah — untungnya ketahuan sebelum diolah. Setelah pakai Safestrip selama 3 minggu, saya berhasil mendeteksi 4 kemasan yang kondisinya borderline dan langsung mengolahnya duluan. Tidak ada lagi kekhawatiran soal komplain dari klien. Untuk usaha katering yang bertanggung jawab atas makanan banyak orang, ini bukan pilihan — ini keharusan.",
    impact: "Deteksi 4 kemasan borderline dalam 3 minggu pertama",
  },

  // ── GRID CARDS ──────────────────────────────────────────────────────────────
  {
    name: "Dwi Nurhasanah",
    initials: "DN",
    role: "Ibu Rumah Tangga",
    company: null,
    location: "Malang",
    badgeLabel: "Konsumen Pribadi",
    badgeClass: "bg-emerald-50 text-emerald-700 border border-emerald-200",
    avatarRing: "ring-emerald-200",
    stars: 5,
    featured: false,
    quote:
      "Saya rutin beli daging giling 1 kg lalu bagi jadi beberapa bungkus untuk dibekukan. Sekarang tiap bungkus saya kasih Safestrip. Sekali lihat warnanya masih ungu, langsung tenang. Tidak perlu lagi tebak-tebakan atau cium dulu setiap kali mau masak untuk anak.",
    avatarFrom: "from-emerald-400",
    avatarTo: "to-teal-500",
  },
  {
    name: "Andriani Putri",
    initials: "AP",
    role: "Reseller Frozen Food Online",
    company: "@andrianifrozen",
    location: "Blitar",
    badgeLabel: "Reseller Online",
    badgeClass: "bg-indigo-50 text-indigo-700 border border-indigo-200",
    avatarRing: "ring-indigo-200",
    stars: 5,
    featured: false,
    quote:
      "Saya kirim frozen food ke berbagai kota via ekspedisi. Dulu sempat ada komplain produk sampai berbau. Sejak sertakan Safestrip di tiap kemasan, pembeli malah foto warna stripnya buat konten review mereka sendiri. Kepercayaan pelanggan dan repeat order saya naik.",
    avatarFrom: "from-indigo-400",
    avatarTo: "to-blue-600",
  },
  {
    name: "Sugeng Haryanto",
    initials: "SH",
    role: "Pemilik Warung Ayam Bakar",
    company: "Ayam Bakar Mas Sugeng",
    location: "Batu, Malang",
    badgeLabel: "UMKM Kuliner",
    badgeClass: "bg-amber-50 text-amber-700 border border-amber-200",
    avatarRing: "ring-amber-200",
    stars: 5,
    featured: false,
    quote:
      "Tiap dua hari saya ambil 15 kg ayam dari supplier. Dengan Safestrip, bisa langsung sortir mana yang harus diolah duluan. Sudah sebulan pakai, belum ada komplain pelanggan soal kualitas daging. Kerugian stok yang terbuang berkurang drastis.",
    avatarFrom: "from-amber-400",
    avatarTo: "to-orange-500",
  },
  {
    name: "Nabila Fitria",
    initials: "NF",
    role: "Mahasiswi S1 Ilmu Gizi",
    company: "Universitas Brawijaya",
    location: "Malang",
    badgeLabel: "Konsumen Pribadi",
    badgeClass: "bg-teal-50 text-teal-700 border border-teal-200",
    avatarRing: "ring-teal-200",
    stars: 5,
    featured: false,
    quote:
      "Kulkas kos sering mati listrik, jadi daging yang tadi segar bisa berubah dalam semalam. Safestrip bantu saya memutuskan dengan yakin — buang atau masih aman. Dari perspektif gizi, konsepnya solid: deteksi NH₃ jauh lebih objektif dari sniff test.",
    avatarFrom: "from-teal-400",
    avatarTo: "to-cyan-600",
  },
  {
    name: "Heni Kristianti",
    initials: "HK",
    role: "Pengelola Kantin",
    company: "SDN 3 Malang",
    location: "Malang",
    badgeLabel: "Kantin Sekolah",
    badgeClass: "bg-violet-50 text-violet-700 border border-violet-200",
    avatarRing: "ring-violet-200",
    stars: 5,
    featured: false,
    quote:
      "Anak SD sistem imunnya lebih rentan. Saya tidak bisa ambil risiko sekecil apapun soal kesegaran bahan masak. Safestrip buat saya dan para orang tua lebih tenang. Harganya sangat terjangkau untuk budget kantin sekolah negeri.",
    avatarFrom: "from-violet-400",
    avatarTo: "to-purple-600",
  },
];

// Helper: render N bintang penuh sebagai string SVG path d= 
const STAR_PATH =
  "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z";

const featured = testimonials[0];
const gridCards = testimonials.slice(1);
---

<section
  id="testimonial"
  class="relative overflow-hidden border-t border-slate-100 bg-slate-50 px-6 py-24 lg:px-10 lg:py-32"
  aria-labelledby="testimonial-heading"
>
  <!-- Dekoratif -->
  <div
    class="pointer-events-none absolute -right-48 -top-24 h-96 w-96 rounded-full bg-violet-200/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-teal-200/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-6xl">

    <!-- ── Section Header ─────────────────────────────────────────────────── -->
    <div class="reveal mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-violet-600">
        Social Proof · Early Tester
      </p>
      <h2
        id="testimonial-heading"
        class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl"
      >
        Dipercaya Pengguna
        <span class="bg-gradient-to-r from-violet-600 to-teal-600 bg-clip-text text-transparent">
          Batch Perdana
        </span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-500">
        Feedback nyata dari early tester fase uji produk di area Malang Raya dan sekitarnya —
        ibu rumah tangga, pelaku UMKM, hingga pengelola katering dan kantin.
      </p>
    </div>

    <!-- ── Stats Bar ──────────────────────────────────────────────────────── -->
    <div class="reveal mb-12">
      <div
        class="mx-auto grid max-w-2xl grid-cols-3 divide-x divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs"
      >
        <div class="px-6 py-5 text-center">
          <p class="text-3xl font-extrabold text-slate-900">4.9</p>
          <div class="mt-1 flex justify-center gap-0.5" aria-label="Rating 4.9 dari 5 bintang">
            {Array.from({ length: 5 }).map(() => (
              <svg
                class="h-4 w-4 text-amber-400"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={STAR_PATH} />
              </svg>
            ))}
          </div>
          <p class="mt-1 text-xs font-semibold text-slate-400 uppercase tracking-wide">
            Rata-rata Rating
          </p>
        </div>

        <div class="px-6 py-5 text-center">
          <p class="text-3xl font-extrabold text-slate-900">100%</p>
          <p class="mt-1 text-sm font-bold text-emerald-600">✓ Semua Puas</p>
          <p class="mt-1 text-xs font-semibold text-slate-400 uppercase tracking-wide">
            Merekomendasikan
          </p>
        </div>

        <div class="px-6 py-5 text-center">
          <p class="text-3xl font-extrabold text-slate-900">3</p>
          <p class="mt-1 text-sm font-bold text-violet-600">Sapi · Ayam · Ikan</p>
          <p class="mt-1 text-xs font-semibold text-slate-400 uppercase tracking-wide">
            Protein Diuji
          </p>
        </div>
      </div>
    </div>

    <!-- ── Featured Testimonial ───────────────────────────────────────────── -->
    <div class="reveal mb-6">
      <figure
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-violet-600 via-indigo-700 to-violet-800 p-8 shadow-xl shadow-violet-500/20 sm:p-10"
        aria-label={`Testimoni dari ${featured.name}, ${featured.role}`}
      >
        <!-- Tanda petik dekoratif -->
        <svg
          class="absolute right-8 top-6 h-24 w-24 text-white/5 sm:h-32 sm:w-32"
          viewBox="0 0 100 80"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M0 80V48Q0 24 12 12T48 0h8v16h-8q-12 0-18 6T26 40h22v40H0zm52 0V48Q52 24 64 12T100 0v16q-12 0-18 6T78 40h22v40H52z"
          />
        </svg>

        <div class="relative flex flex-col gap-8 sm:flex-row sm:items-start">

          <!-- Kutipan + Impact -->
          <div class="flex-1">
            <!-- Badge -->
            <span
              class={`mb-5 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${featured.badgeClass}`}
            >
              🏆 Testimoni Pilihan
            </span>

            <!-- Stars -->
            <div
              class="mb-4 flex gap-1"
              aria-label={`${featured.stars} dari 5 bintang`}
            >
              {Array.from({ length: featured.stars }).map(() => (
                <svg
                  class="h-5 w-5 text-amber-300"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </div>

            <!-- Quote text -->
            <blockquote>
              <p class="text-lg font-medium leading-relaxed text-white/90 sm:text-xl">
                "{featured.quote}"
              </p>
            </blockquote>

            <!-- Impact chip -->
            <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 backdrop-blur-sm">
              <svg
                class="h-4 w-4 flex-shrink-0 text-teal-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                />
              </svg>
              <p class="text-sm font-semibold text-white/80">
                {featured.impact}
              </p>
            </div>
          </div>

          <!-- Avatar + Info -->
          <div class="flex flex-row items-center gap-4 sm:flex-col sm:items-end sm:text-right">
            <div
              class={`flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-2xl bg-white/20 text-xl font-black text-white backdrop-blur-sm ring-2 ${featured.avatarRing}`}
              aria-hidden="true"
            >
              {featured.initials}
            </div>
            <div>
              <p class="font-bold text-white">{featured.name}</p>
              <p class="text-sm text-white/70">{featured.role}</p>
              {featured.company && (
                <p class="text-sm font-semibold text-teal-300">{featured.company}</p>
              )}
              <p class="mt-1 text-xs text-white/50">
                <svg
                  class="mr-1 inline-block h-3 w-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                {featured.location}
              </p>
            </div>
          </div>
        </div>
      </figure>
    </div>

    <!-- ── Grid Testimonials (5 cards) ───────────────────────────────────── -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gridCards.map((t, i) => (
        <figure
          class:list={[
            "reveal group flex flex-col gap-5 rounded-3xl border border-slate-200/80 bg-white p-7 shadow-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5",
            i === 0 ? "reveal-delay-1" : "",
            i === 1 ? "reveal-delay-2" : "",
            i === 2 ? "reveal-delay-3" : "",
          ]}
          aria-label={`Testimoni dari ${t.name}, ${t.role}`}
        >
          <!-- Header: Avatar + Nama + Badge -->
          <div class="flex items-start justify-between gap-3">
            <!-- Avatar -->
            <div class="flex items-center gap-3">
              <div
                class={`flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${t.avatarFrom} ${t.avatarTo} text-sm font-black text-white ring-2 ring-offset-1 ${t.avatarRing}`}
                aria-hidden="true"
              >
                {t.initials}
              </div>
              <div>
                <p class="font-bold text-slate-900 text-sm leading-tight">
                  {t.name}
                </p>
                <p class="text-xs text-slate-500 leading-tight mt-0.5">
                  {t.role}
                  {t.company && (
                    <span class="block font-medium text-slate-600">{t.company}</span>
                  )}
                </p>
              </div>
            </div>

            <!-- Stars -->
            <div
              class="flex flex-shrink-0 gap-0.5"
              aria-label={`${t.stars} dari 5 bintang`}
            >
              {Array.from({ length: t.stars }).map(() => (
                <svg
                  class="h-4 w-4 text-amber-400"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </div>
          </div>

          <!-- Quote -->
          <blockquote class="flex-1">
            <p class="text-sm leading-relaxed text-slate-600">
              "{t.quote}"
            </p>
          </blockquote>

          <!-- Footer: Location + Badge -->
          <figcaption class="flex items-center justify-between gap-2 border-t border-slate-100 pt-4">
            <p class="flex items-center gap-1 text-xs text-slate-400">
              <svg
                class="h-3 w-3 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
              {t.location}
            </p>
            <span
              class={`rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide ${t.badgeClass}`}
            >
              {t.badgeLabel}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- ── CTA bawah ──────────────────────────────────────────────────────── -->
    <div class="reveal mt-12 text-center">
      <p class="text-sm text-slate-500">
        Ingin produkmu masuk batch berikutnya dan testimonimu ada di sini?
      </p>
      <a
        href="#order"
        class="mt-3 inline-flex items-center gap-2 rounded-full bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:bg-slate-700 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0"
      >
        Bergabung Sekarang
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </a>
    </div>

  </div>
</section>