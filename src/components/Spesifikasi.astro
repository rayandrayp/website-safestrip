                        </p>
                    </div>

                    <!-- Baris tabel -->
                    <dl class="divide-y divide-slate-100">

                        <div class="group grid grid-cols-2 transition-colors duration-150 hover:bg-slate-50/60">
                            <dt class="flex items-center gap-2.5 px-6 py-4 text-sm font-medium text-navy-muted/70">
                                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-blue" aria-hidden="true"></span>
                                Bahan Aktif
                            </dt>
                            <dd class="flex items-center px-6 py-4 text-sm font-semibold text-navy">
                                Antosianin Ubi Ungu
                            </dd>
                        </div>

                        <div class="group grid grid-cols-2 transition-colors duration-150 hover:bg-slate-50/60">
                            <dt class="flex items-center gap-2.5 px-6 py-4 text-sm font-medium text-navy-muted/70">
                                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-blue" aria-hidden="true"></span>
                                Prinsip Kerja
                            </dt>
                            <dd class="flex items-center px-6 py-4 text-sm font-semibold text-navy">
                                Deteksi gas amonia (pH responsif)
                            </dd>
                        </div>

                        <div class="group grid grid-cols-2 transition-colors duration-150 hover:bg-slate-50/60">
                            <dt class="flex items-center gap-2.5 px-6 py-4 text-sm font-medium text-navy-muted/70">
                                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-blue" aria-hidden="true"></span>
                                Indikator Warna
