                    <div class="mt-5 space-y-3">
                        <div class="flex items-center gap-3 rounded-xl bg-fuchsia-50/60 px-4 py-3">
                            <span class="h-4 w-4 flex-shrink-0 rounded-full bg-safe shadow-sm" aria-hidden="true"></span>
                            <div>
                                <p class="text-sm font-semibold text-navy">Ungu Kemerahan</p>
                                <p class="text-xs text-navy-muted/60">Daging segar — aman dikonsumsi</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 rounded-xl bg-teal-50/60 px-4 py-3">
                            <span class="h-4 w-4 flex-shrink-0 rounded-full bg-strip shadow-sm" aria-hidden="true"></span>
                            <div>
                                <p class="text-sm font-semibold text-navy">Hijau Kebiruan</p>
                                <p class="text-xs text-navy-muted/60">Daging tidak layak — jangan dikonsumsi</p>
                            </div>
                        </div>
                    </div>
                </div>

