                            <dt class="flex items-center gap-2.5 px-6 py-4 text-sm font-medium text-navy-muted/70">
                                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-blue" aria-hidden="true"></span>
