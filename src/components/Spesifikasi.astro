                            </dt>
                            <dd class="flex items-center px-6 py-4 text-sm font-semibold text-navy">
                                Program Kreativitas Mahasiswa (PKM)
                            </dd>
                        </div>

                    </dl>
                </div>
            </div>

            <!-- Kartu Kemasan + Catatan (kanan, sempit) -->
