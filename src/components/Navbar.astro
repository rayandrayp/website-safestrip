---
const navLinks = [
	{ label: 'Masalah', href: '#masalah' },
	{ label: 'Cara Kerja', href: '#cara-penggunaan' },
	{ label: 'Spesifikasi', href: '#spesifikasi' },
	{ label: 'Team', href: '#team' },
	{ label: 'FAQ', href: '#faq' },
];
---

<header
	id="site-header"
	class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md"
>
	<nav
		class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-10"
		aria-label="Navigasi utama"
	>
		<!-- Logo -->
		<a
			href="#hero"
			class="text-lg font-semibold tracking-tight transition-opacity duration-300 hover:opacity-80"
			aria-label="Safestrip — kembali ke atas"
		>
			<span class="text-safe">Safe</span><span class="text-strip">strip</span>
		</a>

		<!-- Desktop: link navigasi + tombol CTA -->
		<div class="flex items-center gap-6 lg:gap-8">
			<ul class="hidden items-center gap-6 md:flex lg:gap-8" role="list">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-nav-link
								class="nav-link relative text-sm font-medium text-navy-muted/70 transition-colors duration-200 hover:text-navy after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-0 after:bg-strip after:transition-all after:duration-300 hover:after:w-full"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<a
				href="#order"
				class="hidden rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-muted hover:shadow-md active:translate-y-0 md:inline-flex"
			>
				Pesan Sekarang
			</a>

			<!-- Mobile: tombol hamburger -->
			<button
				id="hamburger-btn"
				type="button"
				aria-controls="mobile-menu"
				aria-expanded="false"
				aria-label="Buka menu navigasi"
				class="relative flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-navy transition-colors duration-200 hover:bg-slate-50 md:hidden"
			>
				<!-- Ikon hamburger (☰) — tampil saat menu tertutup -->
				<svg
					id="icon-open"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					class="h-5 w-5"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="4" y1="7" x2="20" y2="7" />
					<line x1="4" y1="12" x2="20" y2="12" />
					<line x1="4" y1="17" x2="20" y2="17" />
				</svg>

				<!-- Ikon X (✕) — tampil saat menu terbuka -->
				<svg
					id="icon-close"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					class="absolute h-5 w-5 opacity-0 transition-opacity duration-200"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="18" y1="6" x2="6" y2="18" />
					<line x1="6" y1="6" x2="18" y2="18" />
				</svg>
			</button>
		</div>
	</nav>

	<!-- Mobile: panel menu (tersembunyi secara default) -->
	<div
		id="mobile-menu"
		role="dialog"
		aria-label="Menu navigasi mobile"
		aria-modal="false"
		class="hidden border-t border-slate-100 bg-white/95 backdrop-blur-md md:hidden"
	>
		<div class="mx-auto max-w-6xl px-6 pb-6 pt-4 lg:px-10">
			<ul class="flex flex-col gap-1" role="list">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-mobile-link
								class="flex w-full items-center rounded-xl px-4 py-3 text-sm font-medium text-navy-muted/80 transition-colors duration-150 hover:bg-slate-50 hover:text-navy"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="mt-4 border-t border-slate-100 pt-4">
				<a
					href="#order"
					data-mobile-link
					class="flex w-full items-center justify-center rounded-full bg-navy px-5 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-navy-muted active:scale-95"
				>
					Pesan Sekarang
				</a>
			</div>
		</div>
	</div>
</header>

<!-- Overlay gelap di belakang menu mobile -->
<div
	id="menu-overlay"
	class="fixed inset-0 z-40 bg-navy/20 opacity-0 backdrop-blur-[1px] transition-opacity duration-300 md:hidden"
	style="pointer-events: none;"
	aria-hidden="true"
></div>

<script>
	// ─── Elemen ──────────────────────────────────────────────────────────────
	const header      = document.getElementById('site-header')!;
	const btn         = document.getElementById('hamburger-btn')!;
	const menu        = document.getElementById('mobile-menu')!;
	const overlay     = document.getElementById('menu-overlay')!;
	const iconOpen    = document.getElementById('icon-open')!;
	const iconClose   = document.getElementById('icon-close')!;
	const mobileLinks = document.querySelectorAll('[data-mobile-link]');
	const desktopLinks = document.querySelectorAll('[data-nav-link]');

	// ─── State ───────────────────────────────────────────────────────────────
	let isOpen = false;

	// ─── Buka / tutup menu ───────────────────────────────────────────────────
	function openMenu() {
		isOpen = true;
		menu.classList.remove('hidden');
		// Paksa reflow agar transisi CSS berjalan
		menu.getBoundingClientRect();
		overlay.style.pointerEvents = 'auto';
		overlay.style.opacity = '1';
		btn.setAttribute('aria-expanded', 'true');
		btn.setAttribute('aria-label', 'Tutup menu navigasi');
		iconOpen.style.opacity  = '0';
		iconClose.style.opacity = '1';
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		isOpen = false;
		overlay.style.opacity = '0';
		overlay.style.pointerEvents = 'none';
		btn.setAttribute('aria-expanded', 'false');
		btn.setAttribute('aria-label', 'Buka menu navigasi');
		iconOpen.style.opacity  = '1';
		iconClose.style.opacity = '0';
		document.body.style.overflow = '';

		// Sembunyikan setelah transisi overlay selesai (300ms)
		setTimeout(() => {
			if (!isOpen) menu.classList.add('hidden');
		}, 300);
	}

	function toggleMenu() {
		isOpen ? closeMenu() : openMenu();
	}

	// ─── Event: tombol hamburger ─────────────────────────────────────────────
	btn.addEventListener('click', toggleMenu);

	// ─── Event: klik link di mobile menu → tutup menu ───────────────────────
	mobileLinks.forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	// ─── Event: klik overlay → tutup menu ───────────────────────────────────
	overlay.addEventListener('click', closeMenu);

	// ─── Event: tekan Escape → tutup menu ───────────────────────────────────
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) closeMenu();
	});

	// ─── Event: resize ke desktop → tutup menu jika terbuka ─────────────────
	window.addEventListener('resize', () => {
		if (window.innerWidth >= 768 && isOpen) closeMenu();
	});

	// ─── Active link: warnai link sesuai section yang sedang terlihat ────────
	const sections = document.querySelectorAll('section[id]');

	const activateLink = (id: string) => {
		desktopLinks.forEach((link) => {
			const href = link.getAttribute('href');
			if (href === `#${id}`) {
				link.classList.add('text-navy', 'after:w-full');
				link.classList.remove('text-navy-muted/70', 'after:w-0');
			} else {
				link.classList.remove('text-navy', 'after:w-full');
				link.classList.add('text-navy-muted/70', 'after:w-0');
			}
		});
	};

	const sectionObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					activateLink(entry.target.id);
				}
			});
		},
		{
			rootMargin: '-30% 0px -65% 0px',
			threshold: 0,
		},
	);

	sections.forEach((section) => sectionObserver.observe(section));
</script>