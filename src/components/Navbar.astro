---
const navLinks = [
	{ label: 'Cara Kerja', href: '#mekanisme' },
	{ label: 'Keunggulan', href: '#fitur' },
	{ label: 'Spesifikasi', href: '#spesifikasi' },
];
---

<header
	class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md"
>
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-10">
		<a
			href="#hero"
			class="text-lg font-semibold tracking-tight transition-opacity duration-300 hover:opacity-80"
		>
			<span class="text-safe">Safe</span><span class="text-strip">strip</span>
		</a>

		<div class="flex items-center gap-6 lg:gap-8">
			<ul class="hidden items-center gap-6 md:flex lg:gap-8">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-sm font-medium text-navy-muted transition-colors duration-300 hover:text-navy"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<a
				href="#kontak"
				class="rounded-full bg-navy px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-muted hover:shadow-md active:translate-y-0"
			>
				Pesan Sekarang
			</a>
		</div>
	</nav>
</header>
