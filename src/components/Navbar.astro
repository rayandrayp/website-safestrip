---
const navLinks = [
    { label: 'Urgensi', href: '#masalah' },
    { label: 'Inovasi', href: '#solusi-fitur' },
    { label: 'Produk', href: '#spesifikasi' },
    { label: 'Tentang Kami', href: '#team' },
    { label: 'Bantuan', href: '#faq' },
];
---

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur-lg"
>
    <nav
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10"
        aria-label="Navigasi Utama Safestrip"
    >
        <a
            href="#hero"
            class="text-xl font-bold tracking-tight text-slate-900 transition-opacity hover:opacity-80"
        >
            Safe<span class="text-violet-600">strip</span>
        </a>

        <div class="flex items-center gap-8">
            <ul class="hidden md:flex items-center gap-8" role="list">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                data-nav-link
                                class="nav-link text-sm font-semibold text-slate-600 transition-colors duration-200 hover:text-violet-600"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>

            <a
                href="#order"
                class="hidden md:inline-flex rounded-full bg-slate-900 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-slate-800 hover:shadow-lg active:scale-95"
            >
                Pesan Sekarang
            </a>

            <button
                id="hamburger-btn"
                type="button"
                aria-label="Buka menu navigasi"
                class="md:hidden p-2 text-slate-700"
            >
                <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
                <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </nav>
    
    </header>