---
import {
  Home,
  Store,
  FlaskConical,
  ShieldCheck,
  Leaf,
  BadgeCheck,
  User,
  Mail,
  MessageSquare,
} from "lucide-astro";

const packages = [
  {
    title: "Paket Personal",
    quantity: "5 Strip",
    price: "Rp 24.900",
    desc: "Ideal untuk kebutuhan rumah tangga dan pengujian awal kualitas daging atau ikan.",
    featured: false,
    icon: Home,
  },
  {
    title: "UMKM & Resto",
    quantity: "10 Strip",
    price: "Rp 44.900",
    desc: "Cocok untuk usaha frozen food, katering, rumah makan, dan distribusi pangan.",
    featured: true,
    icon: Store,
  },
  {
    title: "Research Partner",
    quantity: "Custom",
    price: "Hubungi Kami",
    desc: "Kolaborasi riset, validasi laboratorium, dan pengembangan produk bersama.",
    featured: false,
    icon: FlaskConical,
  },
];
---

<section id="order" class="relative overflow-hidden py-24 ">
  <!-- Background Decoration -->

  <div
    class="absolute inset-0 bg-gradient-to-b from-white via-violet-50/40 to-cyan-50/40"
  >
  </div>

  <div
    class="absolute left-0 top-0 h-72 w-72 rounded-full bg-violet-300/20 blur-3xl"
  >
  </div>

  <div
    class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <!-- Header -->

    <div class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-4 py-2 text-sm font-medium text-violet-700"
      >
        Dapatkan Safestrip
      </span>

      <h2
        class="mt-6 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl"
      >
        Mulai Pantau Kesegaran
        <span
          class="bg-gradient-to-r from-violet-600 to-teal-600 bg-clip-text text-transparent"
        >
          Secara Visual
        </span>
      </h2>

      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        Pilih paket yang sesuai kebutuhan Anda atau hubungi tim kami untuk pilot
        testing, kolaborasi riset, dan kemitraan.
      </p>
    </div>

    <div class="grid gap-10 lg:grid-cols-2">
      <!-- Pricing Cards -->

      <div class="grid gap-6">
        {
          packages.map((item) => (
            <div
              class:list={[
                "group rounded-3xl border bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl",
                item.featured
                  ? "border-violet-300 ring-2 ring-violet-100"
                  : "border-slate-200",
              ]}
            >
              {item.featured && (
                <div class="mb-4 inline-flex rounded-full bg-violet-600 px-3 py-1 text-xs font-semibold text-white">
                  PALING POPULER
                </div>
              )}

              <div class="flex items-start justify-between">
                <div class="flex items-start gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-100 to-cyan-100">
                    <item.icon class="h-6 w-6 text-violet-700" />
                  </div>

                  <div>
                    <h3 class="text-xl font-bold text-slate-900">
                      {item.title}
                    </h3>

                    <p class="mt-1 text-slate-500">{item.quantity}</p>
                  </div>
                </div>

                <div class="text-right">
                  <div class="text-2xl font-bold text-slate-900">
                    {item.price}
                  </div>
                </div>
              </div>

              <p class="mt-4 leading-relaxed text-slate-600">{item.desc}</p>
            </div>
          ))
        }
        <div class="flex flex-wrap gap-3">
          <div
            class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"
          >
            <ShieldCheck class="h-4 w-4 text-green-600" />
            <span class="text-sm"> Aman untuk pangan </span>
          </div>

          <div
            class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"
          >
            <Leaf class="h-4 w-4 text-green-600" />
            <span class="text-sm"> Berbasis bahan alami </span>
          </div>

          <div
            class="flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm"
          >
            <BadgeCheck class="h-4 w-4 text-green-600" />
            <span class="text-sm"> Mudah diaplikasikan </span>
          </div>
        </div>
      </div>

      <!-- Contact Form -->

      <div
        class="rounded-[32px] border border-slate-200 bg-white/90 p-8 shadow-xl backdrop-blur"
      >
        <h3 class="text-2xl font-bold text-slate-900">Form Permintaan</h3>

        <p class="mt-2 text-slate-600">
          Isi formulir berikut dan tim Safestrip akan menghubungi Anda.
        </p>

        <form
          action="https://formspree.io/f/xjgqbrvk"
          method="POST"
          class="mt-8 space-y-5"
        >
          <input type="hidden" name="_next" value="https://safestrip-three.vercel.app/#order">
          
          <input type="text" name="_gotcha" style="display:none" />

          <div class="relative">
            <User
                class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
            />
            <input
                type="text"
                name="name"
                placeholder="Nama Lengkap"
                required
                class="w-full rounded-2xl border border-slate-300 pl-12 pr-4 py-3 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100"
            />
          </div>

          <div class="relative">
            <Mail
                class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
            />
            <input
                type="email"
                name="email"
                placeholder="Email"
                required
                class="w-full rounded-2xl border border-slate-300 pl-12 pr-4 py-3 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100"
            />
          </div>

          <div class="relative">
                <MessageSquare
                    class="absolute left-4 top-4 h-5 w-5 text-slate-400 pointer-events-none"
                />
                <textarea
                    rows="5"
                    name="message"
                    placeholder="Tuliskan kebutuhan atau pertanyaan Anda..."
                    required
                    class="w-full rounded-2xl border border-slate-300 bg-white py-3 pl-12 pr-4 outline-none transition focus:border-violet-500 focus:ring-4 focus:ring-violet-100"
                ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-2xl bg-gradient-to-r from-violet-600 to-teal-600 px-6 py-4 font-semibold text-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl"
          >
            Kirim Permintaan
          </button>
        </form>

        <div class="mt-6">
          <a
            href="https://wa.me/6285755554151"
            target="_blank"
            class="flex items-center justify-center rounded-2xl border border-green-300 bg-green-50 px-6 py-4 font-semibold text-green-700 transition hover:bg-green-100"
          >
            Chat via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
