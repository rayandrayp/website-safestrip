---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import OrderSection from "../components/OrderSection.astro";
import ScienceSection from '../components/ScienceSection.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-image.png';
---

<Layout>
	<Navbar />

	<main>
		<!-- Hero -->
		<section
			id="hero"
			class="relative overflow-hidden px-6 pb-28 pt-16 lg:px-10 lg:pb-36 lg:pt-20"
			aria-labelledby="hero-heading"
		>
			<div class="pointer-events-none absolute inset-0 -z-10">
				<div class="absolute -right-40 top-0 h-[28rem] w-[28rem] rounded-full bg-accent-blue-soft/60 blur-3xl"></div>
				<div
					class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-gradient-to-br from-fuchsia-100/40 to-teal-100/40 blur-3xl"
				>
				</div>
			</div>

			<div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<div class="reveal">
					<h1
						id="hero-heading"
						class="text-4xl font-bold leading-[1.15] tracking-tight text-navy sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]"
					>
						Pastikan Daging Tetap Segar Sebelum Dimasak
					</h1>

					<p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-muted/80 sm:text-xl">
						Safestrip adalah indikator pintar yang mendeteksi pembusukan daging & ikan langsung dari
						dalam kemasan.
					</p>

					<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
						<a
							href="#kontak"
							class="inline-flex w-full items-center justify-center rounded-full bg-navy px-8 py-3.5 text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-muted hover:shadow-lg active:translate-y-0 sm:w-auto"
						>
							Beli Safestrip
						</a>
						<a
							href="#mekanisme"
							class="inline-flex w-full items-center justify-center rounded-full border border-slate-300 bg-white px-8 py-3.5 text-base font-medium text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-blue/50 hover:shadow-md active:translate-y-0 sm:w-auto"
						>
							Lihat Cara Kerja
						</a>
					</div>
				</div>

				<div class="reveal reveal-delay-1">
					<div
						class="aspect-[4/5] w-full max-w-md mx-auto lg:max-w-none rounded-2xl bg-gray-200 shadow-[0_25px_50px_-12px_rgba(12,35,64,0.25)] transition-transform duration-500 hover:-translate-y-1"
						role="img"
						aria-label="Mockup kemasan depan produk Safestrip"
					>
						<Image 
      src={heroImg} 
      alt="Safestrip Smart Meat Quality Indicator" 
      format="webp"
      quality={80}
      class="w-full h-auto object-cover rounded-3xl shadow-2xl shadow-blue-900/10 border border-white/50"
    />
					</div>
				</div>
			</div>
		</section>

		<!-- Masalah & Solusi -->
		<section
			class="bg-blue-50 px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="masalah-heading"
		>
			<div class="mx-auto max-w-6xl">
				<h2
					id="masalah-heading"
					class="reveal mx-auto max-w-3xl text-center text-3xl font-bold tracking-tight text-navy sm:text-4xl"
				>
					Sulit Membedakan Daging Segar Hanya dari Tampilan Luar?
				</h2>

				<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:gap-8">
					<article
						class="reveal reveal-delay-1 rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm"
					>
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-red-500"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M8 14c-2-3-1-7 2-9s6-1 8 2-1 7-4 9-6 1-8-2z" />
								<path d="M9 13l-1 4" />
								<path d="M15 9l2-2" />
							</svg>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-navy">Tanpa Safestrip</h3>
						<p class="mt-3 leading-relaxed text-navy-muted/75">
							Risiko mengonsumsi daging yang sudah mulai membusuk namun belum berbau menyengat.
						</p>
					</article>

					<article
						class="reveal reveal-delay-2 rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm"
					>
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-strip"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 12l2 2 4-4" />
								<circle cx="12" cy="12" r="9" />
							</svg>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-navy">Dengan Safestrip</h3>
						<p class="mt-3 leading-relaxed text-navy-muted/75">
							Cukup lihat perubahan warna. Perubahan
							<span class="font-medium text-safe">ungu kemerahan</span>
							menjadi
							<span class="font-medium text-strip">hijau kebiruan</span>
							menandakan daging tidak layak konsumsi.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Cara Penggunaan -->
		<section
			id="cara-penggunaan"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="cara-penggunaan-heading"
		>
			<div class="mx-auto max-w-6xl">
				<h2
					id="cara-penggunaan-heading"
					class="reveal mx-auto max-w-3xl text-center text-3xl font-bold tracking-tight text-navy sm:text-4xl"
				>
					Cara Penggunaan
				</h2>

				<ol class="mt-16 flex flex-col items-stretch gap-0 md:flex-row md:items-start">
					<li class="reveal reveal-delay-1 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="6" cy="6" r="3" />
								<circle cx="6" cy="18" r="3" />
								<path d="M8.12 8.12 12 12" />
								<path d="M20 4 8.12 15.88" />
								<circle cx="18" cy="18" r="3" />
								<path d="M15.88 15.88 12 12" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Gunting/Lepaskan</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							Lepaskan strip label perekat pelindung.
						</p>
					</li>

					<li class="flex flex-1 items-center justify-center py-6 md:max-w-24 md:py-0 md:pt-7 md:min-w-12" aria-hidden="true">
						<div class="h-10 w-px border-l-2 border-dashed border-slate-300 md:h-px md:w-full md:border-l-0 md:border-t-2"></div>
					</li>

					<li class="reveal reveal-delay-2 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
								<path d="m3.3 7 8.7 5 8.7-5" />
								<path d="M12 22V12" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Tempelkan</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							Tempelkan strip pada bagian dinding dalam kemasan makanan.
						</p>
					</li>

					<li class="flex flex-1 items-center justify-center py-6 md:max-w-24 md:py-0 md:pt-7 md:min-w-12" aria-hidden="true">
						<div class="h-10 w-px border-l-2 border-dashed border-slate-300 md:h-px md:w-full md:border-l-0 md:border-t-2"></div>
					</li>

					<li class="reveal reveal-delay-3 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
								<circle cx="12" cy="12" r="3" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Pantau Warna</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							<span class="font-medium text-safe">Ungu kemerahan</span> = Segar.
							<span class="font-medium text-strip">Hijau kebiruan</span> = Busuk/Tidak Segar.
						</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- Fitur Utama -->
		<section
			id="fitur"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="fitur-heading"
		>
			<div class="mx-auto max-w-6xl">
				<div class="reveal mx-auto max-w-2xl text-center">
					<p class="text-xs font-semibold uppercase tracking-widest text-accent-blue">Keunggulan</p>
					<h2 id="fitur-heading" class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">
						Sensor Visual yang Akurat & Praktis
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-navy-muted/75">
						Dirancang khusus untuk memantau kualitas daging dan ikan secara real-time di dalam kemasan.
					</p>
				</div>

				<div class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">

					<!-- Fitur 1: Alami & Aman -->
					<article class="reveal reveal-delay-1 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-strip transition-colors duration-300 group-hover:bg-teal-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
								<path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Alami & Bebas Kimia Berbahaya</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Terbuat dari ekstrak antosianin ubi ungu — pewarna alami yang aman bersentuhan dengan kemasan makanan dan tidak mencemari produk.
							</p>
						</div>
					</article>

					<!-- Fitur 2: Tidak Perlu Alat -->
					<article class="reveal reveal-delay-2 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-50 text-navy transition-colors duration-300 group-hover:bg-slate-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
								<circle cx="12" cy="12" r="3"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Cukup Lihat dengan Mata</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Tidak butuh aplikasi, scanner, atau perangkat tambahan. Perubahan warna langsung terlihat — siapa saja bisa membaca hasilnya dalam hitungan detik.
							</p>
						</div>
					</article>

					<!-- Fitur 3: Real-Time -->
					<article class="reveal reveal-delay-3 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-50 text-accent-blue transition-colors duration-300 group-hover:bg-sky-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Deteksi Real-Time, 24 Jam</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Strip bereaksi secara kontinu terhadap gas amonia yang dihasilkan proses pembusukan — memantau kualitas daging setiap saat tanpa batas waktu.
							</p>
						</div>
					</article>

					<!-- Fitur 4: Di dalam kemasan -->
					<article class="reveal reveal-delay-1 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-fuchsia-50 text-safe transition-colors duration-300 group-hover:bg-fuchsia-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
								<path d="m3.3 7 8.7 5 8.7-5"/>
								<path d="M12 22V12"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Bekerja di Dalam Kemasan</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Ditempel langsung di dinding dalam kemasan daging — mendeteksi perubahan dari sumbernya tanpa perlu membuka plastik atau wadah terlebih dahulu.
							</p>
						</div>
					</article>

					<!-- Fitur 5: Multi-jenis daging -->
					<article class="reveal reveal-delay-2 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-strip transition-colors duration-300 group-hover:bg-teal-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
								<path d="m9 12 2 2 4-4"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Cocok untuk 3 Jenis Protein</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Telah diuji dan terbukti akurat pada
								<span class="font-medium text-navy">daging sapi</span>,
								<span class="font-medium text-navy">ayam</span>, dan
								<span class="font-medium text-navy">ikan</span> — jenis protein hewani yang paling umum dikonsumsi rumah tangga Indonesia.
							</p>
						</div>
					</article>

					<!-- Fitur 6: Ramah Lingkungan -->
					<article class="reveal reveal-delay-3 group flex flex-col gap-4">
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-50 text-green-600 transition-colors duration-300 group-hover:bg-green-100"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>
								<path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/>
								<path d="m14 16-3 3 3 3"/>
								<path d="M8.293 13.596 7.196 9.5 3.1 10.598"/>
								<path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/>
								<path d="m13.378 9.633 4.096 1.098 1.097-4.096"/>
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-semibold text-navy">Ramah Lingkungan</h3>
							<p class="mt-2 text-sm leading-relaxed text-navy-muted/75">
								Bahan aktif berasal dari sumber nabati yang dapat terurai secara alami. Mengurangi pemborosan makanan sekaligus meminimalkan limbah kimia sintetis.
							</p>
						</div>
					</article>

				</div>
			</div>
		</section>

		<!-- Mekanisme / Indikator Warna -->
		<section id="mekanisme" class="py-24 px-6 lg:px-10 bg-slate-50">
			<div class="mx-auto max-w-6xl">
				<div class="flex flex-col lg:flex-row gap-16 items-start">
					
					<!-- Sisi Kiri: Penjelasan + Indikator Statis -->
					<div class="flex-1 space-y-8">
						<div>
							<span class="text-accent-blue font-semibold tracking-wider uppercase text-sm">Cara Kerja</span>
							<h2 class="text-4xl lg:text-5xl font-bold text-navy leading-tight mt-2">
								Sensor Pintar <br/> dalam Genggaman
							</h2>
							<p class="text-lg text-navy-muted/70 mt-6 max-w-lg">
								Safestrip memanfaatkan reaksi kimia alami yang sensitif terhadap gas amonia (NH3) yang dihasilkan oleh protein saat membusuk. 
							</p>
						</div>

						<!-- Indikator Visual (diintegrasikan dari "Screenshot 2026-06-21 at 12.32.30.png") -->
						<div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
							<h3 class="text-xs font-bold text-slate-400 tracking-widest text-center uppercase mb-6">
								Indikator Visual
							</h3>
							
							<!-- Gradient Bar -->
							<div class="h-4 w-full rounded-full bg-gradient-to-r from-violet-600 to-emerald-500 shadow-inner"></div>
							
							<!-- Labels -->
							<div class="flex justify-between mt-3 text-sm font-medium text-slate-600">
								<span>Ungu Kemerahan · Segar</span>
								<span>Hijau Kebiruan · Tidak Layak</span>
							</div>
						</div>
					</div>

					<!-- Sisi Kanan: Simulasi Interaktif -->
					<div class="relative w-full lg:w-96 lg:mt-10">
						<div class="absolute -inset-4 bg-gradient-to-tr from-blue-100 to-teal-100 rounded-[2rem] blur-2xl opacity-50"></div>
						
						<div class="relative bg-white p-8 rounded-[2rem] shadow-2xl shadow-blue-900/10 border border-slate-100 flex flex-col items-center">
							<p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-8">Uji Coba Sensor</p>
							
							<!-- Sensor Visual -->
							<div id="sensor-visual" class="w-20 h-40 rounded-full bg-violet-600 shadow-[0_0_20px_rgba(124,58,237,0.3)] transition-all duration-700 ease-in-out border-4 border-white"></div>
							
							<div class="mt-8 text-center">
								<h3 id="status-text" class="text-2xl font-bold text-navy">Segar</h3>
								<p id="desc-text" class="text-sm text-slate-500 mt-1">Daging dalam kondisi optimal</p>
							</div>

							<button id="simulate-btn" class="mt-8 w-full py-3 rounded-xl bg-navy text-white font-semibold hover:bg-navy-muted transition-all active:scale-95">
								Simulasi Pembusukan
							</button>
						</div>
					</div>
				</div>
			</div>
		</section>


		<!-- Spesifikasi Produk -->
		<section
			id="spesifikasi"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="spesifikasi-heading"
		>
			<div class="mx-auto max-w-6xl">

				<!-- Header -->
				<div class="reveal mx-auto max-w-2xl text-center">
					<p class="text-xs font-semibold uppercase tracking-widest text-accent-blue">Spesifikasi</p>
					<h2 id="spesifikasi-heading" class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">
						Detail Produk Safestrip
