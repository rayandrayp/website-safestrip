---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout>
	<Navbar />

	<main>
		<!-- Hero -->
		<section
			id="hero"
			class="relative overflow-hidden px-6 pb-28 pt-16 lg:px-10 lg:pb-36 lg:pt-20"
			aria-labelledby="hero-heading"
		>
			<div class="pointer-events-none absolute inset-0 -z-10">
				<div class="absolute -right-40 top-0 h-[28rem] w-[28rem] rounded-full bg-accent-blue-soft/60 blur-3xl"></div>
				<div
					class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-gradient-to-br from-fuchsia-100/40 to-teal-100/40 blur-3xl"
				>
				</div>
			</div>

			<div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<div class="reveal">
					<h1
						id="hero-heading"
						class="text-4xl font-bold leading-[1.15] tracking-tight text-navy sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]"
					>
						Pastikan Daging Tetap Segar Sebelum Dimasak
					</h1>

					<p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-muted/80 sm:text-xl">
						Safestrip adalah indikator pintar yang mendeteksi pembusukan daging & ikan langsung dari
						dalam kemasan.
					</p>

					<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
						<a
							href="#kontak"
							class="inline-flex w-full items-center justify-center rounded-full bg-navy px-8 py-3.5 text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-muted hover:shadow-lg active:translate-y-0 sm:w-auto"
						>
							Beli Safestrip
						</a>
						<a
							href="#mekanisme"
							class="inline-flex w-full items-center justify-center rounded-full border border-slate-300 bg-white px-8 py-3.5 text-base font-medium text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-blue/50 hover:shadow-md active:translate-y-0 sm:w-auto"
						>
							Lihat Cara Kerja
						</a>
					</div>
				</div>

				<div class="reveal reveal-delay-1">
					<div
						class="aspect-[4/5] w-full max-w-md mx-auto lg:max-w-none rounded-2xl bg-gray-200 shadow-[0_25px_50px_-12px_rgba(12,35,64,0.25)] transition-transform duration-500 hover:-translate-y-1"
						role="img"
						aria-label="Mockup kemasan depan produk Safestrip"
					>
					</div>
				</div>
			</div>
		</section>

		<!-- Masalah & Solusi -->
		<section
			class="bg-blue-50 px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="masalah-heading"
		>
			<div class="mx-auto max-w-6xl">
				<h2
					id="masalah-heading"
					class="reveal mx-auto max-w-3xl text-center text-3xl font-bold tracking-tight text-navy sm:text-4xl"
				>
					Sulit Membedakan Daging Segar Hanya dari Tampilan Luar?
				</h2>

				<div class="mt-16 grid gap-6 sm:grid-cols-2 lg:gap-8">
					<article
						class="reveal reveal-delay-1 rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm"
					>
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-50 text-red-500"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M8 14c-2-3-1-7 2-9s6-1 8 2-1 7-4 9-6 1-8-2z" />
								<path d="M9 13l-1 4" />
								<path d="M15 9l2-2" />
							</svg>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-navy">Tanpa Safestrip</h3>
						<p class="mt-3 leading-relaxed text-navy-muted/75">
							Risiko mengonsumsi daging yang sudah mulai membusuk namun belum berbau menyengat.
						</p>
					</article>

					<article
						class="reveal reveal-delay-2 rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm"
					>
						<div
							class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-50 text-strip"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 12l2 2 4-4" />
								<circle cx="12" cy="12" r="9" />
							</svg>
						</div>
						<h3 class="mt-6 text-xl font-semibold text-navy">Dengan Safestrip</h3>
						<p class="mt-3 leading-relaxed text-navy-muted/75">
							Cukup lihat perubahan warna. Perubahan
							<span class="font-medium text-safe">ungu kemerahan</span>
							menjadi
							<span class="font-medium text-strip">hijau kebiruan</span>
							menandakan daging tidak layak konsumsi.
						</p>
					</article>
				</div>
			</div>
		</section>

		<!-- Cara Penggunaan -->
		<section
			id="cara-penggunaan"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="cara-penggunaan-heading"
		>
			<div class="mx-auto max-w-6xl">
				<h2
					id="cara-penggunaan-heading"
					class="reveal mx-auto max-w-3xl text-center text-3xl font-bold tracking-tight text-navy sm:text-4xl"
				>
					Cara Penggunaan
				</h2>

				<ol class="mt-16 flex flex-col items-stretch gap-0 md:flex-row md:items-start">
					<li class="reveal reveal-delay-1 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="6" cy="6" r="3" />
								<circle cx="6" cy="18" r="3" />
								<path d="M8.12 8.12 12 12" />
								<path d="M20 4 8.12 15.88" />
								<circle cx="18" cy="18" r="3" />
								<path d="M15.88 15.88 12 12" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Gunting/Lepaskan</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							Lepaskan strip label perekat pelindung.
						</p>
					</li>

					<li class="flex flex-1 items-center justify-center py-6 md:max-w-24 md:py-0 md:pt-7 md:min-w-12" aria-hidden="true">
						<div class="h-10 w-px border-l-2 border-dashed border-slate-300 md:h-px md:w-full md:border-l-0 md:border-t-2"></div>
					</li>

					<li class="reveal reveal-delay-2 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
								<path d="m3.3 7 8.7 5 8.7-5" />
								<path d="M12 22V12" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Tempelkan</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							Tempelkan strip pada bagian dinding dalam kemasan makanan.
						</p>
					</li>

					<li class="flex flex-1 items-center justify-center py-6 md:max-w-24 md:py-0 md:pt-7 md:min-w-12" aria-hidden="true">
						<div class="h-10 w-px border-l-2 border-dashed border-slate-300 md:h-px md:w-full md:border-l-0 md:border-t-2"></div>
					</li>

					<li class="reveal reveal-delay-3 flex flex-1 flex-col items-center text-center">
						<div
							class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-navy/10 bg-slate-50 text-navy"
							aria-hidden="true"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
								<circle cx="12" cy="12" r="3" />
							</svg>
						</div>
						<h3 class="mt-5 text-lg font-semibold text-navy">Pantau Warna</h3>
						<p class="mt-2 max-w-xs text-sm leading-relaxed text-navy-muted/75">
							<span class="font-medium text-safe">Ungu kemerahan</span> = Segar.
							<span class="font-medium text-strip">Hijau kebiruan</span> = Busuk/Tidak Segar.
						</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- Fitur Utama -->
		<section
			id="fitur"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="fitur-heading"
		>
			<div class="mx-auto max-w-6xl">
				<div class="reveal mx-auto max-w-2xl text-center">
					<p class="text-xs font-semibold uppercase tracking-widest text-accent-blue">Keunggulan</p>
					<h2 id="fitur-heading" class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">
						Sensor Visual yang Akurat & Praktis
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-navy-muted/75">
						Dirancang khusus untuk memantau kualitas daging dan ikan secara real-time di dalam kemasan.
					</p>
				</div>

				<div class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
					<!-- Konten fitur akan ditambahkan di langkah berikutnya -->
				</div>
			</div>
		</section>

		<!-- Mekanisme / Indikator Warna -->
		<section
			id="mekanisme"
			class="px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="mekanisme-heading"
		>
			<div class="mx-auto max-w-6xl">
				<div class="reveal mx-auto max-w-2xl text-center">
					<p class="text-xs font-semibold uppercase tracking-widest text-accent-blue">Cara Kerja</p>
					<h2 id="mekanisme-heading" class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">
						Perubahan Warna sebagai Sinyal
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-navy-muted/75">
						Indikator berubah otomatis ketika mutu makanan mulai menurun — tanpa alat tambahan.
					</p>
				</div>

				<div class="reveal reveal-delay-1 mx-auto mt-16 max-w-lg">
					<div
						class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-shadow duration-300 hover:shadow-md"
					>
						<p class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-navy-muted/60">
							Indikator Visual
						</p>
						<div class="h-4 w-full overflow-hidden rounded-full bg-gradient-strip shadow-inner"></div>
						<div class="mt-4 flex justify-between text-xs font-medium text-navy-muted/70">
							<span>Ungu Kemerahan · Segar</span>
							<span>Hijau Kebiruan · Tidak Layak</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Tentang Produk -->
		<section
			id="spesifikasi"
			class="border-t border-slate-200/70 bg-white px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="tentang-heading"
		>
			<div class="mx-auto max-w-6xl">
				<div class="reveal mx-auto max-w-3xl text-center">
					<p class="text-xs font-semibold uppercase tracking-widest text-accent-blue">Tentang</p>
					<h2 id="tentang-heading" class="mt-3 text-3xl font-bold tracking-tight text-navy sm:text-4xl">
						Inovasi PKM untuk Keamanan Pangan
					</h2>
					<p class="mt-5 text-lg leading-relaxed text-navy-muted/75">
						Solusi sederhana berbasis antosianin ubi ungu — aman, praktis, dan mudah diaplikasikan siapa saja.
					</p>
				</div>
			</div>
		</section>

		<!-- Kontak / CTA -->
		<section
			id="kontak"
			class="px-6 py-28 lg:px-10 lg:py-36"
			aria-labelledby="kontak-heading"
		>
			<div class="reveal mx-auto max-w-3xl text-center">
				<h2 id="kontak-heading" class="text-3xl font-bold tracking-tight text-navy sm:text-4xl">
					Tertarik dengan Safestrip?
				</h2>
				<p class="mt-5 text-lg text-navy-muted/75">
					Hubungi tim PKM Safestrip untuk informasi lebih lanjut.
				</p>
				<a
					href="mailto:contact@safestrip.id"
					class="mt-10 inline-flex items-center justify-center rounded-full bg-navy px-10 py-4 text-base font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-navy-muted hover:shadow-lg active:translate-y-0"
				>
					Hubungi Kami
				</a>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="border-t border-slate-200/70 bg-white px-6 py-10 lg:px-10">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 sm:flex-row">
			<p class="text-sm text-navy-muted/60">
				&copy; {new Date().getFullYear()} Safestrip — Smart Meat Quality Indicator
			</p>
			<p class="text-sm text-navy-muted/40">Produk Inovasi PKM · 5 strip per kemasan</p>
		</div>
	</footer>

	<script>
		const reveals = document.querySelectorAll('.reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
		);

		reveals.forEach((el) => observer.observe(el));
	</script>
</Layout>
