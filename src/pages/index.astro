---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Masalah from '../components/Masalah.astro';
import FiturUtama from '../components/FiturUtama.astro';
import Mekanisme from '../components/Mekanisme.astro';
import CaraPenggunaan from '../components/CaraPenggunaan.astro';
import Spesifikasi from '../components/Spesifikasi.astro';
import Footer from '../components/Footer.astro';
import OrderSection from "../components/OrderSection.astro";
import ScienceSection from '../components/ScienceSection.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import TeamSection from '../components/Team.astro';
import FAQ from '../components/FAQ.astro';
// ↓ BARU: import TestimonialSection
import TestimonialSection from '../components/TestimonialSection.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		<Masalah />
		<FiturUtama />
		<Mekanisme />
		<ScienceSection />
		<CaraPenggunaan />
		<Spesifikasi />
		<!-- ↓ BARU: ditempatkan tepat sebelum OrderSection (social proof → CTA) -->
		<TestimonialSection />
		<OrderSection />
		<RoadmapSection />
		<TeamSection />
		<FAQ />
	</main>

	<Footer />

	<script>
		// UNIFIED: Satu observer untuk semua elemen .reveal di seluruh halaman.
		// Mengadopsi unobserve() dari RoadmapSection (System 2) — lebih efisien
		// karena elemen berhenti diobservasi setelah animasi berjalan sekali.
		const reveals = document.querySelectorAll('.reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						// Berhenti mengamati setelah animasi selesai → hemat memori
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.08, rootMargin: '0px 0px -48px 0px' },
		);

		reveals.forEach((el) => observer.observe(el));

		// Re-inisialisasi saat navigasi SPA (Astro View Transitions)
		document.addEventListener('astro:page-load', () => {
			document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => observer.observe(el));
		});
	</script>

	<script>
		const btn = document.getElementById('simulate-btn') as HTMLButtonElement;
		const sensor = document.getElementById('sensor-visual');
		const statusText = document.getElementById('status-text');
		const descText = document.getElementById('desc-text');

		let isBad = false;

		btn?.addEventListener('click', () => {
			isBad = !isBad;
			
			if (isBad) {
				sensor?.classList.replace('bg-violet-600', 'bg-emerald-500');
				sensor?.classList.replace('shadow-[0_0_20px_rgba(124,58,237,0.3)]', 'shadow-[0_0_20px_rgba(16,185,129,0.3)]');
				if(statusText) statusText.innerText = 'Tidak Layak';
				if(descText) descText.innerText = 'Segera buang produk';
				btn.innerText = 'Reset Sensor';
			} else {
				sensor?.classList.replace('bg-emerald-500', 'bg-violet-600');
				sensor?.classList.replace('shadow-[0_0_20px_rgba(16,185,129,0.3)]', 'shadow-[0_0_20px_rgba(124,58,237,0.3)]');
				if(statusText) statusText.innerText = 'Segar';
				if(descText) descText.innerText = 'Daging dalam kondisi optimal';
				btn.innerText = 'Simulasi Pembusukan';
			}
		});
	</script>
	
</Layout>